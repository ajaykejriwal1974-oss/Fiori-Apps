<mvc:View
    controllerName="kejriwal.pp.batchstatus.controller.Worklist"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">
    <Page id="page" title="{i18n>appTitle}">
        <subHeader>
            <!-- Filter-first worklist: the binding below starts SUSPENDED, so the app no
                 longer loads (and $count-s) the ENTIRE entity set on first paint - rows
                 appear when the user presses Go with a filter (or none, explicitly). -->
            <OverflowToolbar id="filterBar">
                <Label text="Company"/>
                <Input id="inpCompanyCode" width="9rem" submit=".onFilterSearch" showValueHelp="true" valueHelpRequest=".onCompanyCodeVH"/>
                <Label text="{i18n>colPlant}"/>
                <Input id="inpPlant" width="10rem" submit=".onFilterSearch" showValueHelp="true" valueHelpRequest=".onPlantVH"/>
                <Label text="{i18n>colMaterial}"/>
                <Input id="inpMaterial" width="10rem" submit=".onFilterSearch" showValueHelp="true" valueHelpRequest=".onMaterialVH"/>
                <Label text="{i18n>colBatch}"/>
                <Input id="inpBatch" width="10rem" submit=".onFilterSearch" showValueHelp="true" valueHelpRequest=".onBatchVH"/>
                <ToolbarSpacer/>
                <Button id="btnGo" text="Go" type="Emphasized" press=".onFilterSearch"/>
            </OverflowToolbar>
        </subHeader>
        <content>
            <Table sticky="ColumnHeaders,HeaderToolbar"
                id="table"
                items="{ path: '/Batch', suspended: true }"
                mode="MultiSelect"
                growing="true"
                growingThreshold="50">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="{i18n>worklistTitle}"/>
                        <ToolbarSpacer/>
                        <Button text="{i18n>actcloseBatch}" press=".onCloseBatch" type="Emphasized"/>
                        <Button text="{i18n>actdeleteBatch}" press=".onDeleteBatch" type="Emphasized"/>
                        <SearchField width="14rem" search=".onQuickSearch" placeholder="Search"/>
                        <Button icon="sap-icon://sort" tooltip="Sort" press=".onOpenSort"/>
                        <Button icon="sap-icon://excel-attachment" tooltip="Export to Excel" press=".onExportExcel"/>
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                        <Column><Text text="Company"/></Column>
                        <Column><Text text="{i18n>colMaterial}"/></Column>
                        <Column><Text text="{i18n>colPlant}"/></Column>
                        <Column><Text text="{i18n>colBatch}"/></Column>
                        <Column><Text text="{i18n>colLastGoodsReceiptDate}"/></Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{CompanyCode}"/>
                            <Text text="{Material}"/>
                            <Text text="{Plant}"/>
                            <Text text="{Batch}"/>
                            <Text text="{LastGoodsReceiptDate}"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>
