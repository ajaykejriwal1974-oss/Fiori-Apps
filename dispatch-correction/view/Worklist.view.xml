<mvc:View
    controllerName="kejriwal.sd.dispatchcorrection.controller.Worklist"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">
    <Page id="page" title="{i18n>appTitle}">
        <subHeader>
            <!-- Filter-first worklist: the binding below starts SUSPENDED, so the app no
                 longer loads (and $count-s) the ENTIRE entity set on first paint - rows
                 appear when the user presses Go with a filter (or none, explicitly). -->
            <OverflowToolbar id="filterBar">
                <Label text="{i18n>colBoxNumber}"/>
                <Input id="inpBoxNumber" width="10rem" submit=".onFilterSearch"/>
                <Label text="{i18n>colSalesOrder}"/>
                <Input id="inpSalesOrder" width="10rem" submit=".onFilterSearch" showValueHelp="true" valueHelpRequest=".onSalesOrderVH"/>
                <Label text="{i18n>colStatus}"/>
                <Input id="inpStatus" width="10rem" submit=".onFilterSearch"/>
                <ToolbarSpacer/>
                <Button id="btnGo" text="Go" type="Emphasized" press=".onFilterSearch"/>
            </OverflowToolbar>
        </subHeader>
        <content>
            <Table sticky="ColumnHeaders,HeaderToolbar"
                id="table"
                items="{ path: '/DispatchBox', suspended: true }"
                mode="MultiSelect"
                growing="true"
                growingThreshold="50">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="{i18n>worklistTitle}"/>
                        <ToolbarSpacer/>
                        <Button text="{i18n>actcorrectDispatch}" press=".onCorrectDispatch" type="Emphasized"/>
                        <SearchField width="14rem" search=".onQuickSearch" placeholder="Search"/>
                        <Button icon="sap-icon://sort" tooltip="Sort" press=".onOpenSort"/>
                        <Button icon="sap-icon://excel-attachment" tooltip="Export to Excel" press=".onExportExcel"/>
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                        <Column><Text text="{i18n>colBoxNumber}"/></Column>
                        <Column><Text text="{i18n>colSalesOrder}"/></Column>
                        <Column><Text text="{i18n>colSalesOrderItem}"/></Column>
                        <Column><Text text="{i18n>colMaterial}"/></Column>
                        <Column><Text text="{i18n>colGrade}"/></Column>
                        <Column><Text text="{i18n>colStatus}"/></Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{BoxNumber}"/>
                            <Text text="{SalesOrder}"/>
                            <Text text="{SalesOrderItem}"/>
                            <Text text="{Material}"/>
                            <Text text="{Grade}"/>
                            <Text text="{Status}"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>
