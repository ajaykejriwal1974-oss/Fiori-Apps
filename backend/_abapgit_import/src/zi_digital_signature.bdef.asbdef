managed;

define behavior for ZI_DIGITAL_SIGNATURE alias DigiSign
persistent table ztdigi_sign
lock master
{
  create;
  update;
  delete;

  field ( mandatory : create ) CompanyCode;

  mapping for ztdigi_sign
  {
    CompanyCode          = bukrs;
    Email                = email;
    Password             = pwd;
    IpAddress            = ip;
    PfxPrefix            = pfx;
    SourceFolder         = source_folder;
    DestinationFolder    = dest_folder;
  }
}