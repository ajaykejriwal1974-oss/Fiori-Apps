@Metadata.layer: #CORE
@UI: {
  headerInfo: {
    typeName: 'Account Group',
    typeNamePlural: 'Account Groups',
    title:       { type: #STANDARD, value: 'GroupCode' },
    description: { type: #STANDARD, value: 'GroupText' }
  }
}
annotate view ZC_ACCGRP with
{
  @UI.facet: [
    { id: 'General',  purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE, label: 'General Information', position: 10 },
    { id: 'Accounts', purpose: #STANDARD, type: #LINEITEM_REFERENCE,       label: 'Assigned G/L Accounts', position: 20, targetElement: '_Accounts' }
  ]

  @UI: {
    lineItem:       [ { position: 10, importance: #HIGH } ],
    identification: [ { position: 10 } ],
    selectionField: [ { position: 10 } ]
  }
  @EndUserText.label: 'Account Group'
  GroupCode;

  @UI: {
    lineItem:       [ { position: 20, importance: #HIGH } ],
    identification: [ { position: 20 } ],
    selectionField: [ { position: 20 } ]
  }
  @EndUserText.label: 'Description'
  GroupText;

  @UI: {
    lineItem:       [ { position: 30 } ],
    identification: [ { position: 30 } ]
  }
  @EndUserText.label: 'Sign Reversal'
  SignReversal;
}
