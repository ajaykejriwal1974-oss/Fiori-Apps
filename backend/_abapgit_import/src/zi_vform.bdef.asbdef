// Managed, NON-DRAFT, CLASS-FREE BO over the existing legacy table ZVFORM2.
// No `strict`, no `authorization` - same proven shape as the class-free master fleet.
// Quantity and Currency are CALCULATED fields in ZI_VFORM (cast expressions), so they
// are read-only and are NOT in the mapping (only persistable table columns are mapped).
managed;

define behavior for ZI_VFORM alias VendorInvoice
persistent table zvform2
lock master
{
  create;
  update;
  delete;

  field ( mandatory : create ) InvoiceNumber;

  mapping for zvform2
  {
    InvoiceNumber      = invoice_no;
    PurchasingDocument = purchase_doc;
    ReferenceNumber    = reference_no;
    Supplier           = vend_code;
    SupplierName       = vend_name;
    InvoiceDate        = invoice_dt;
    InvoiceValue       = invoice_val;
    AllocatedValue     = allocated_value1;
    UnallocatedValue   = un_allot_val;
    AllocatedFlag      = allocate_chk;
    FormType           = form_type;
    FormNumber         = form_no;
    FormDate           = form_dt;
    FormValue          = form_val;
    CourierName        = currier_name;
    CourierDetail      = currier_detail;
  }
}
