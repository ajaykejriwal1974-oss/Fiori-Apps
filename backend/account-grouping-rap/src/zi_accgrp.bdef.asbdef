// Managed, NON-DRAFT, CLASS-FREE BO over the existing legacy tables ZSOL_ACCGRP
// (group master) and ZSOL_ACC_GRP (G/L account -> group assignment). Clean-core
// replacement for transaction ZSOL_ACCGRP (program SAPLZSOL_DASH).
//
// Notes:
//  - No `strict` : the composition child trips a strict(2) rule; the proven
//    class-free masters on KSD (e.g. ZI_RECIPE) are non-strict. Kept consistent.
//  - No `authorization` : instance authorization needs a behavior class; this BO
//    is class-free, so authorization is omitted (as the other class-free masters).
//  - No `etag master`/admin fields : the legacy tables have none; concurrency is
//    handled by the pessimistic `lock master`. No DDIC change to live data.
managed;

define behavior for ZI_ACCGRP alias AccountGroup
persistent table zsol_accgrp
lock master
{
  create;
  update;
  delete;
  association _Accounts { create; }

  field ( mandatory : create ) GroupCode;

  mapping for zsol_accgrp
  {
    GroupCode    = zzsol_grp;
    GroupText    = text50;
    SignReversal = zsign_rev;
  }
}

define behavior for ZI_ACCGRP_ACC alias AccountAssignment
persistent table zsol_acc_grp
lock dependent by _Group
{
  update;
  delete;
  field ( readonly ) GroupCode;
  field ( mandatory : create ) GLAccount;
  association _Group;

  mapping for zsol_acc_grp
  {
    GroupCode = zzsol_grp;
    GLAccount = racct;
  }
}
