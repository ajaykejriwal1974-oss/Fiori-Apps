unmanaged implementation in class zbp_i_packing_list unique;

// INSTANCE actions (not static): the RAP runtime populates the handler's `keys`
// with the selected instances (BoxNumber + BoxYear), so the action updates exactly
// the boxes the user selected — and the box year is the instance key (no
// SELECT SINGLE gjahr guess). Static actions left `keys` empty (BoxesAffected 0).

define behavior for ZI_PACKING_LIST alias PackingList
{
  action createPackingList parameter ZD_PACKING_LIST_IMPORT result [1] ZD_PACKING_LIST_RESULT;
  action changePackingList parameter ZD_PACKING_LIST_IMPORT result [1] ZD_PACKING_LIST_RESULT;
  action deletePackingList result [1] ZD_PACKING_LIST_RESULT;
}
