// Small master maintained by the packing desk. Managed RAP: RAP owns the
// persistence, there is no BAPI behind it. All three key fields are entered by
// the user (plant + label type + printer IP), so there is no managed numbering.
managed implementation in class zbp_i_label_master unique;
strict ( 2 );

define behavior for ZI_LABEL_MASTER alias LabelMaster
persistent table zpp_label
lock master
authorization master ( instance )
{
  create;
  update;
  delete;

  field ( mandatory : create, readonly : update ) Plant, LabelType, IPAddress;
  field ( mandatory ) LabelText;

  mapping for zpp_label
  {
    Plant     = werks;
    LabelType = type;
    IPAddress = ip;
    LabelText = text;
    IsDefault = dflt;
  }
}
