managed implementation in class zbp_i_label_master unique;
strict ( 2 );

define behavior for ZI_LABEL_MASTER alias LabelMaster
persistent table zpp_label
lock master
authorization master ( global )
{
  create;
  update;
  delete;

  field ( mandatory : create, readonly : update ) Plant, LabelType, IPAddress;
  field ( mandatory ) LabelText;

  // One default printer per plant and label type. Nothing enforced this, and
  // plant 2002 has drifted: measured 2026-08-30, of 14 printers per type,
  // KIL has 9 marked default and BLNK has 3. Whatever asks for "the default
  // printer" gets whichever row the database happens to return first.
  //
  // Last one wins: saving a row with IsDefault = 'X' clears the flag on the
  // other rows of the same plant and type. Refusing the save instead would
  // leave the operator to hunt down and clear the old default by hand, and
  // with nine of them that is worse.
  determination enforceSingleDefault on save { create; update; }

  mapping for zpp_label
  {
    Plant     = werks;
    LabelType = type;
    IPAddress = ip;
    LabelText = text;
    IsDefault = dflt;
  }
}
