unmanaged implementation in class zbp_i_mtos_process unique;
define behavior for ZI_MTOS_PROCESS alias MtosStock
{
  // ZMTOS  - transfer make-to-order stock to own/MTS stock
  static action convertToMts    parameter ZD_MTO_MTS  result [1] ZD_MTO_MTS_RESULT;
  // ZHUINV - create the physical-inventory document for the HU/MTO stock
  static action createPhysInvDoc parameter ZD_PHYS_INV result [1] ZD_PHYS_INV_RESULT;
}