// Unmanaged. QM results cannot be written with a plain update - the standard
// BAPIs own the logic (valuation against the selected set, sample arithmetic,
// status handling, the usage decision follow-on). So RAP reads through the
// CDS views and writes through BAPI_INSPCHAR_SETRESULT and friends.
//
// No draft table. Specification v2 called for ZQC_RESULT_DRAFT because a
// fastness battery is not entered in one sitting. That turned out to be
// unnecessary: BAPI_INSPCHAR_SETRESULT persists a result without confirming
// the operation, and QAMR-SATZSTATUS already distinguishes recorded from
// confirmed. QM has had the draft concept all along.
unmanaged implementation in class zbp_i_qc_insp_lot unique;
strict ( 2 );

define behavior for ZI_QC_INSP_LOT alias InspectionLot
{
  // Read-only header. Lots are created by QM at goods receipt or order
  // release, never by this app.
  action recordResults    parameter ZD_QC_RECORD_RESULTS  result [1] $self;
  action setUsageDecision parameter ZD_QC_USAGE_DECISION  result [1] $self;

  association _Characteristic;
}

define behavior for ZI_QC_INSP_CHAR alias Characteristic
{
  update;

  // Everything from QAMV is specification, not result. Only the four result
  // fields a technician actually types are writable.
  field ( readonly ) InspectionLot, OperationNumber, CharacteristicNumber,
                     MasterCharacteristic, CharacteristicName, CharacteristicKind,
                     CharacteristicUnit, DecimalPlaces,
                     TargetValue, TargetIsInitial,
                     LowerLimit, LowerLimitIsInitial,
                     UpperLimit, UpperLimitIsInitial,
                     SelectedSet, CatalogType,
                     Valuation, ResultStatus, Inspector, InspectionDate;

  association _InspectionLot;
}
