// Unmanaged, and the ONLY behaviour definition in this service.
//
// The original design made ZI_QC_INSP_CHAR an updatable composition child so
// the technician could PATCH a result row directly. That is the textbook RAP
// pattern and it could not be activated in KSD: the parent refuses until the
// child's ACTIVE version carries a to-parent association, and the child cannot
// carry one until the parent exists. Four joint activations failed.
//
// So characteristics are read-only, reached by a plain association, and every
// result is written by an action on the lot. For a technician who enters nine
// to fifteen results and then presses Save, one action per changed row inside
// a single $batch is no worse than a PATCH per row - and it activates.
unmanaged implementation in class zbp_i_qc_insp_lot unique;
strict ( 2 );

define behavior for ZI_QC_INSP_LOT alias InspectionLot
{
  // Read-only header. Lots are created by QM at goods receipt or order
  // release, never by this app.

  // One result for one characteristic. Called once per changed row.
  action recordSingleResult parameter ZD_QC_SINGLE_RESULT result [1] $self;

  // Confirm the operation - no more results accepted afterwards.
  action recordResults      parameter ZD_QC_RECORD_RESULTS result [1] $self;

  // Close the lot with a usage decision.
  action setUsageDecision   parameter ZD_QC_USAGE_DECISION result [1] $self;

  association _Characteristic;
}
