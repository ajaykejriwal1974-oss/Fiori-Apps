<mvc:View
    controllerName="kejriwal.qm.qcpostwinding.controller.Detail"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    height="100%">

    <f:DynamicPage id="detailPage" headerExpanded="true" showFooter="true" fitContent="true">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading><Title text="{Batch}" level="H2"/></f:heading>
                <f:expandedContent><Text text="{MaterialName} - {Material}"/></f:expandedContent>
                <f:navigationActions><Button icon="sap-icon://nav-back" press=".onBack"/></f:navigationActions>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <HBox wrap="Wrap">
                    <ObjectAttribute title="Inspection Lot" text="{InspectionLot}" class="sapUiMediumMarginEnd"/>
                    <ObjectAttribute title="Quantity" text="{ parts: ['LotQuantity','LotUnit'], formatter: '.fmtQty' }" class="sapUiMediumMarginEnd"/>
                    <ObjectAttribute title="Sample size" text="{ parts: ['SampleSize','SampleUnit'], formatter: '.fmtQty' }"/>
                </HBox>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <VBox>

                <!-- Winding does not change the dye. It damages yarn and
                     packages. So this screen leads with the comparison against
                     the incoming figures - the delta is what winding did, and
                     the absolute value on its own says very little. -->
                <Panel headerText="Yarn condition - compared with incoming" expandable="false"
                       class="sapUiSmallMarginBeginEnd">
                    <content>
                        <VBox class="sapUiSmallMargin">
                            <MessageStrip id="deltaStrip" showIcon="true" type="Information"
                                          text="Incoming figures load from the stage 1 inspection of the greige lot. Elongation loss above 8 percent is a reject."
                                          class="sapUiSmallMarginBottom"/>
                            <HBox wrap="Wrap">
                                <VBox class="sapUiLargeMarginEnd">
                                    <Label text="Final denier"/>
                                    <Input id="denInput" type="Number" width="8rem" textAlign="End" change=".onPairedChange"/>
                                    <ObjectStatus id="denDelta" title="vs incoming" class="sapUiTinyMarginTop"/>
                                </VBox>
                                <VBox class="sapUiLargeMarginEnd">
                                    <Label text="Final elongation"/>
                                    <Input id="elgInput" type="Number" width="8rem" textAlign="End" change=".onPairedChange"/>
                                    <ObjectStatus id="elgDelta" title="loss vs incoming" class="sapUiTinyMarginTop"/>
                                </VBox>
                                <VBox class="sapUiLargeMarginEnd">
                                    <Label text="Broken filaments"/>
                                    <StepInput id="bflInput" min="0" step="1" width="8rem" change=".onPairedChange"/>
                                    <ObjectStatus id="bflDelta" title="added by winding" class="sapUiTinyMarginTop"/>
                                </VBox>
                                <VBox>
                                    <Label text="Winding tension"/>
                                    <Input id="tensInput" type="Number" width="8rem" textAlign="End" change=".onResultChange"/>
                                    <Text text="cN" class="sapUiTinyText"/>
                                </VBox>
                            </HBox>
                        </VBox>
                    </content>
                </Panel>

                <!-- Package geometry: measured values. -->
                <Panel headerText="Package geometry" expandable="true" expanded="true"
                       class="sapUiSmallMarginBeginEnd">
                    <content>
                        <List id="lstGeometry" mode="None"
                              items="{ path: '_Characteristic', parameters: { $$updateGroupId: 'qc' } }">
                            <CustomListItem visible="{= ${CharacteristicKind} === 'QUAN'
                                                      &amp;&amp; ${MasterCharacteristic} !== 'S3_DEN'
                                                      &amp;&amp; ${MasterCharacteristic} !== 'S3_ELG'
                                                      &amp;&amp; ${MasterCharacteristic} !== 'S3_BFL'
                                                      &amp;&amp; ${MasterCharacteristic} !== 'S3_TENS' }">
                                <VBox class="sapUiSmallMargin">
                                    <HBox justifyContent="SpaceBetween" alignItems="Center">
                                        <VBox>
                                            <Text text="{CharacteristicName}" class="sapMTitleStyleH5"/>
                                            <Text text="{ parts: ['MasterCharacteristic','TargetValue','LowerLimit','UpperLimit','CharacteristicUnit','LowerLimitIsInitial','UpperLimitIsInitial'], formatter: '.fmtSpec' }"
                                                  class="sapUiTinyText"/>
                                        </VBox>
                                        <ObjectStatus text="{ path: 'Valuation', formatter: '.fmtValText' }"
                                                      state="{ path: 'Valuation', formatter: '.fmtValState' }"/>
                                    </HBox>
                                    <HBox class="sapUiSmallMarginTop" alignItems="Center">
                                        <Input value="{MeanValue}" type="Number" width="9rem" textAlign="End" change=".onResultChange"/>
                                        <Text text="{CharacteristicUnit}" class="sapUiSmallMarginBegin"/>
                                    </HBox>
                                </VBox>
                            </CustomListItem>
                        </List>
                    </content>
                </Panel>

                <!-- Stage 3 is dominated by attribute checks - taper,
                     ribboning, nose bulge, contamination. All of them are
                     counted over the ISO 2859-1 sample as ONE entry each.
                     Recording them per package would be 2400 entries a day
                     and the app would be abandoned inside a month. -->
                <Panel headerText="Visual defects - count over the sample" expandable="true" expanded="true"
                       class="sapUiSmallMarginBeginEnd">
                    <content>
                        <VBox class="sapUiSmallMargin">
                            <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                                <Label text="Sample size for this lot" class="sapUiTinyMarginEnd"/>
                                <StepInput id="sampleAll" min="0" step="1" width="7rem" change=".onSampleAllChange"/>
                                <Text text="ISO 2859-1 General Inspection Level II" class="sapUiSmallMarginBegin sapUiTinyText"/>
                            </HBox>
                            <List id="lstDefects" mode="None"
                                  items="{ path: '_Characteristic', parameters: { $$updateGroupId: 'qc' },
                                           filters: [ { path: 'SelectedSet', operator: 'EQ', value1: 'ZQC_PF' } ] }">
                                <CustomListItem>
                                    <HBox class="sapUiSmallMargin" justifyContent="SpaceBetween" alignItems="Center">
                                        <VBox>
                                            <Text text="{CharacteristicName}" class="sapMTitleStyleH5"/>
                                            <Text text="{MasterCharacteristic}" class="sapUiTinyText"/>
                                        </VBox>
                                        <HBox alignItems="Center">
                                            <StepInput value="{DefectCount}" min="0" step="1" width="7rem" change=".onResultChange"/>
                                            <ObjectStatus class="sapUiSmallMarginBegin"
                                                          text="{ path: 'Valuation', formatter: '.fmtValText' }"
                                                          state="{ path: 'Valuation', formatter: '.fmtValState' }"/>
                                        </HBox>
                                    </HBox>
                                </CustomListItem>
                            </List>
                        </VBox>
                    </content>
                </Panel>
            </VBox>
        </f:content>

        <f:footer>
            <OverflowToolbar>
                <ToolbarSpacer/>
                <!-- __OperationControl comes back with every InspectionLot read
                     (get_global_authorizations sets it per lot) - gate each
                     button on its own flag so a closed lot or an existing UD
                     disables the button instead of surfacing a raw OData error. -->
                <Button text="Save" press=".onSave"
                        enabled="{= ${ui>/dirty} &amp;&amp; ${__OperationControl/recordSingleResult} }"/>
                <Button text="Record Results" type="Emphasized" press=".onRecord"
                        enabled="{__OperationControl/recordResults}"/>
                <Button text="Usage Decision" type="Attention" press=".onUsageDecision"
                        enabled="{__OperationControl/setUsageDecision}"/>
            </OverflowToolbar>
        </f:footer>
    </f:DynamicPage>
</mvc:View>
