{
  "_version": "1.65.0",
  "sap.app": {
    "id": "kejriwal.qm.qcpostdyeing",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_qc_inspection_04/srvd/sap/zui_qc_inspection/0001/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "QcPostDyeing-inspectKejriwal": {
          "semanticObject": "QcPostDyeing",
          "action": "inspectKejriwal",
          "icon": "sap-icon://palette",
          "title": "{{flpTitle}}",
          "subTitle": "{{flpSubtitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": false
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "kejriwal.qm.qcpostdyeing.view.App",
      "type": "XML",
      "id": "app",
      "height": "100%"
    },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.f": {},
        "sap.ui.layout": {}
      }
    },
    "handleValidation": true,
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "kejriwal.qm.qcpostdyeing.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true,
          "groupId": "$auto"
        }
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "kejriwal.qm.qcpostdyeing.view",
        "controlId": "app",
        "controlAggregation": "pages",
        "async": true
      },
      "routes": [
        {
          "pattern": "",
          "name": "worklist",
          "target": "worklist"
        },
        {
          "pattern": "lot/{lot}",
          "name": "detail",
          "target": "detail"
        }
      ],
      "targets": {
        "worklist": {
          "viewName": "Worklist",
          "viewId": "worklist"
        },
        "detail": {
          "viewName": "Detail",
          "viewId": "detail"
        }
      }
    },
    "contentDensities": {
      "compact": false,
      "cozy": true
    }
  }
}