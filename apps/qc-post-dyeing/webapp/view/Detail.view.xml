<mvc:View
    controllerName="kejriwal.qm.qcpostdyeing.controller.Detail"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    height="100%">

    <f:DynamicPage id="detailPage" headerExpanded="false" showFooter="true" fitContent="true">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading><Title text="{Batch}" level="H2"/></f:heading>
                <f:expandedContent><Text text="{MaterialName} - {Material}"/></f:expandedContent>
                <f:navigationActions><Button icon="sap-icon://nav-back" press=".onBack"/></f:navigationActions>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <HBox wrap="Wrap">
                    <ObjectAttribute title="Inspection Lot" text="{InspectionLot}" class="sapUiMediumMarginEnd"/>
                    <ObjectAttribute title="Order" text="{ProductionOrder}" class="sapUiMediumMarginEnd"/>
                    <ObjectAttribute title="Quantity" text="{ parts: ['LotQuantity','LotUnit'], formatter: '.fmtQty' }" class="sapUiMediumMarginEnd"/>
                    <ObjectAttribute title="Sample" text="{ parts: ['SampleSize','SampleUnit'], formatter: '.fmtQty' }"/>
                </HBox>
            </f:DynamicPageHeader>
        </f:header>

        <f:content><ScrollContainer height="100%" width="100%" vertical="true" horizontal="false">
            <VBox>

                <!-- Shade gets its own panel with an oversized readout. It is
                     the number the whole batch is judged on and the one the
                     technician looks at first. -->
                <!-- The greige lot behind this batch. Operator-selected: the
                     genealogy link is not exposed on the service yet. -->
                <Panel headerText="Raw material lot" expandable="true" expanded="{= !!${rm>/lot} }"
                       class="sapUiSmallMarginBeginEnd">
                    <content>
                        <VBox class="sapUiSmallMargin">
                            <HBox alignItems="Center" wrap="Wrap">
                                <Button text="Select lot" icon="sap-icon://value-help"
                                        press=".onSelectRmLot" class="sapUiTinyMarginEnd"/>
                                <ObjectAttribute title="Batch" text="{rm>/batch}"
                                                 class="sapUiMediumMarginEnd" visible="{= !!${rm>/lot} }"/>
                                <ObjectAttribute title="Lot" text="{rm>/lot}" visible="{= !!${rm>/lot} }"/>
                                <Text text="No raw material lot selected - incoming figures unavailable"
                                      class="sapUiTinyText" visible="{= !${rm>/lot} }"/>
                            </HBox>
                            <List items="{rm>/chars}" mode="None" busy="{rm>/busy}"
                                  class="sapUiSmallMarginTop" visible="{= !!${rm>/lot} }"
                                  noDataText="This lot has no recorded results">
                                <CustomListItem>
                                    <HBox justifyContent="SpaceBetween" alignItems="Center"
                                          class="sapUiSmallMargin">
                                        <VBox>
                                            <Text text="{rm>name}" class="sapMTitleStyleH6"/>
                                            <Text text="{rm>master}" class="sapUiTinyText"/>
                                        </VBox>
                                        <HBox alignItems="Center">
                                            <Text text="{ parts: ['rm>value','rm>unit','rm>code'], formatter: '.fmtRmValue' }"
                                                  class="sapUiMediumMarginEnd"/>
                                            <ObjectStatus text="{ path: 'rm>valuation', formatter: '.fmtValText' }"
                                                          state="{ path: 'rm>valuation', formatter: '.fmtValState' }"/>
                                        </HBox>
                                    </HBox>
                                </CustomListItem>
                            </List>
                        </VBox>
                    </content>
                </Panel>

                <Panel headerText="Shade vs approved standard" expandable="false" class="sapUiSmallMarginBeginEnd">
                    <content>
                        <VBox class="sapUiSmallMargin">
                            <Text text="ISO 105-J03, delta E CMC(2:1). Spectrophotometer D65/10 deg, specular included, UV calibrated. Wind a card to constant thickness."
                                  class="sapUiTinyText sapUiSmallMarginBottom"/>
                            <HBox alignItems="Center">
                                <Input id="deInput" type="Number" width="8rem" textAlign="End"
                                       change=".onDeltaEChange" class="sapUiSmallMarginEnd"/>
                                <ObjectStatus id="deStatus" class="sapMObjectStatusLarge"/>
                            </HBox>
                            <Text id="deHint" class="sapUiTinyText sapUiSmallMarginTop"/>
                            <!-- Says where the reading goes on Save: into the lot's delta E
                                 characteristic, or nowhere, when the inspection plan has no
                                 such characteristic. -->
                            <ObjectStatus id="deTarget" class="sapUiTinyMarginTop"/>
                        </VBox>
                    </content>
                </Panel>

                <!-- Position matters more than count in package dyeing. The
                     dominant failure mode is a gradient - inside to outside,
                     top to bottom of the carrier - so the app prompts for
                     position rather than just a package number. -->
                <Panel headerText="Shade variation - record the position, not just the value"
                       expandable="false" class="sapUiSmallMarginBeginEnd">
                    <content>
                        <VBox class="sapUiSmallMargin">
                            <MessageStrip
                                text="Sample deliberately across the gradient: inner and outer layers of one cheese, and packages from the top, middle and bottom of the carrier."
                                type="Information" showIcon="true" class="sapUiSmallMarginBottom"/>
                            <List id="lstVariation" mode="None"
                                  items="{ path: '_Characteristic', parameters: { $$updateGroupId: 'qc' },
                                           filters: [ { path: 'SelectedSet', operator: 'StartsWith', value1: 'ZQC_GREY' } ] }">
                                <CustomListItem>
                                    <VBox class="sapUiSmallMargin">
                                        <HBox justifyContent="SpaceBetween" alignItems="Center">
                                            <VBox>
                                                <Text text="{CharacteristicName}" class="sapMTitleStyleH5"/>
                                                <Text text="{MasterCharacteristic}" class="sapUiTinyText"/>
                                            </VBox>
                                            <ObjectStatus text="{ path: 'Valuation', formatter: '.fmtValText' }"
                                                          state="{ path: 'Valuation', formatter: '.fmtValState' }"/>
                                        </HBox>
                                        <SegmentedButton class="sapUiSmallMarginTop"
                                                         selectedKey="{ResultCode}" selectionChange=".onCodeChange">
                                            <items>
                                                <SegmentedButtonItem key="GS10" text="1"/>
                                                <SegmentedButtonItem key="GS15" text="1-2"/>
                                                <SegmentedButtonItem key="GS20" text="2"/>
                                                <SegmentedButtonItem key="GS25" text="2-3"/>
                                                <SegmentedButtonItem key="GS30" text="3"/>
                                                <SegmentedButtonItem key="GS35" text="3-4"/>
                                                <SegmentedButtonItem key="GS40" text="4"/>
                                                <SegmentedButtonItem key="GS45" text="4-5"/>
                                                <SegmentedButtonItem key="GS50" text="5"/>
                                            </items>
                                        </SegmentedButton>
                                    </VBox>
                                </CustomListItem>
                            </List>
                        </VBox>
                    </content>
                </Panel>

                <!-- Fastness is a recipe property, not a batch property. The
                     panel only opens for the qualifying batch of a recipe. -->
                <Panel expandable="true" expanded="{ui>/isFirstOfRecipe}" class="sapUiSmallMarginBeginEnd"
                       headerText="Colour fastness - qualifying batch of this recipe">
                    <content>
                        <VBox class="sapUiSmallMargin">
                            <MessageStrip id="fastnessStrip" showIcon="true" class="sapUiSmallMarginBottom"/>
                            <List id="lstFastness" mode="None"
                                  items="{ path: '_Characteristic', parameters: { $$updateGroupId: 'qc' } }">
                                <CustomListItem visible="{= ${MasterCharacteristic}.indexOf('S2_W') === 0
                                                          || ${MasterCharacteristic}.indexOf('S2_RUB') === 0
                                                          || ${MasterCharacteristic}.indexOf('S2_PSP') === 0
                                                          || ${MasterCharacteristic} === 'S2_SUBL' }">
                                    <VBox class="sapUiSmallMargin">
                                        <HBox justifyContent="SpaceBetween" alignItems="Center">
                                            <Text text="{CharacteristicName}" class="sapMTitleStyleH5"/>
                                            <ObjectStatus text="{ path: 'Valuation', formatter: '.fmtValText' }"
                                                          state="{ path: 'Valuation', formatter: '.fmtValState' }"/>
                                        </HBox>
                                        <SegmentedButton class="sapUiSmallMarginTop"
                                                         selectedKey="{ResultCode}" selectionChange=".onCodeChange">
                                            <items>
                                                <SegmentedButtonItem key="GS10" text="1"/>
                                                <SegmentedButtonItem key="GS15" text="1-2"/>
                                                <SegmentedButtonItem key="GS20" text="2"/>
                                                <SegmentedButtonItem key="GS25" text="2-3"/>
                                                <SegmentedButtonItem key="GS30" text="3"/>
                                                <SegmentedButtonItem key="GS35" text="3-4"/>
                                                <SegmentedButtonItem key="GS40" text="4"/>
                                                <SegmentedButtonItem key="GS45" text="4-5"/>
                                                <SegmentedButtonItem key="GS50" text="5"/>
                                            </items>
                                        </SegmentedButton>
                                    </VBox>
                                </CustomListItem>
                            </List>
                        </VBox>
                    </content>
                </Panel>

                <!-- Visual and chemical. Formaldehyde and azo amines normally
                     come back from an external accredited laboratory, so the
                     field wanted is a certificate reference, not a live
                     measurement. -->
                <Panel headerText="Visual and chemical" expandable="true" expanded="false"
                       class="sapUiSmallMarginBeginEnd">
                    <content>
                        <List id="lstOther" mode="None"
                              items="{ path: '_Characteristic', parameters: { $$updateGroupId: 'qc' } }">
                            <!-- Attribute counts and plain measurements. The delta E
                                 characteristic is entered through the shade panel above and
                                 is hidden here so there is one entry point per result. -->
                            <CustomListItem visible="{ parts: ['SelectedSet','CharacteristicKind','MasterCharacteristic'], formatter: '.isOtherRow' }">
                                <VBox class="sapUiSmallMargin">
                                    <HBox justifyContent="SpaceBetween" alignItems="Center">
                                        <VBox>
                                            <Text text="{CharacteristicName}" class="sapMTitleStyleH5"/>
                                            <Text text="{ parts: ['MasterCharacteristic','TargetValue','LowerLimit','UpperLimit','CharacteristicUnit','LowerLimitIsInitial','UpperLimitIsInitial'], formatter: '.fmtSpec' }"
                                                  class="sapUiTinyText"/>
                                        </VBox>
                                        <ObjectStatus text="{ path: 'Valuation', formatter: '.fmtValText' }"
                                                      state="{ path: 'Valuation', formatter: '.fmtValState' }"/>
                                    </HBox>
                                    <HBox class="sapUiSmallMarginTop" alignItems="Center"
                                          visible="{= ${CharacteristicKind} === 'QUAN' }">
                                        <Input value="{MeanValue}" type="Number" width="9rem" textAlign="End" change=".onResultChange"/>
                                        <Text text="{CharacteristicUnit}" class="sapUiSmallMarginBegin"/>
                                        <Input value="{InspectorComment}" width="16rem" placeholder="Certificate reference"
                                               class="sapUiSmallMarginBegin" change=".onResultChange"
                                               visible="{= ${MasterCharacteristic} === 'S2_HCHO' || ${MasterCharacteristic} === 'S2_AZO' }"/>
                                    </HBox>
                                    <HBox class="sapUiSmallMarginTop" alignItems="Center"
                                          visible="{= ${SelectedSet} === 'ZQC_PF' }">
                                        <Label text="Defectives found" class="sapUiTinyMarginEnd"/>
                                        <StepInput value="{DefectCount}" min="0" step="1" width="7rem" change=".onResultChange"/>
                                        <Label text="of sample" class="sapUiSmallMarginBegin sapUiTinyMarginEnd"/>
                                        <StepInput value="{ActualSampleSize}" min="0" step="1" width="7rem" change=".onResultChange"/>
                                    </HBox>
                                </VBox>
                            </CustomListItem>
                        </List>
                    </content>
                </Panel>
            </VBox>
        </ScrollContainer></f:content>

        <f:footer>
            <OverflowToolbar>
                <ToolbarSpacer/>
                <!-- __OperationControl comes back with every InspectionLot read
                     (get_instance_features sets it per lot) - gate each button
                     on its own flag so a closed lot or an existing UD disables
                     the button instead of surfacing a raw OData error.

                     Everything except Save is also disabled while there are
                     unsaved edits: each of these refreshes the lot afterwards,
                     and the V4 model refuses to refresh over pending changes. -->
                <Button text="{i18n>saveDraft}" press=".onSave"
                        enabled="{= ${ui>/dirty} &amp;&amp; !!${__OperationControl/recordSingleResult} }"/>
                <Button text="{i18n>recordResults}" type="Emphasized" press=".onRecord"
                        enabled="{= !${ui>/dirty} &amp;&amp; !!${__OperationControl/recordResults} }"/>
                <Button text="{i18n>usageDecision}" type="Attention" press=".onUsageDecision"
                        enabled="{= !${ui>/dirty} &amp;&amp; !!${__OperationControl/setUsageDecision} }"/>
                <!-- The follow-on step, and a SECOND round trip on purpose.
                     The usage decision posts in its own update task, so the
                     backend keeps this disabled until that decision is on the
                     database and accepting; UsageDecisionMade is checked here
                     as well so the button reads right even before the backend
                     feature control for this action is in place. -->
                <Button text="{i18n>confirmDyeing}" type="Accept" press=".onconfirmDyeing"
                        enabled="{= !${ui>/dirty} &amp;&amp; ${UsageDecisionMade} === 'X' &amp;&amp; !!${__OperationControl/confirmDyeing} }"/>
            </OverflowToolbar>
        </f:footer>
    </f:DynamicPage>
</mvc:View>
