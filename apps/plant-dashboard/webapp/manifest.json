{
  "_version": "1.60.0",
  "sap.app": {
    "id": "kejriwal.plant.dashboard",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": { "version": "1.0.0" },
    "dataSources": {},
    "crossNavigation": {
      "inbounds": {
        "PlantDashboard-display": {
          "semanticObject": "PlantDashboard",
          "action": "display",
          "icon": "sap-icon://business-objects-experience",
          "title": "{{flpTitle}}",
          "subTitle": "{{flpSubtitle}}",
          "signature": { "parameters": {}, "additionalParameters": "allowed" }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": { "desktop": true, "tablet": true, "phone": true }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "handleValidation": true,
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.f": {},
        "sap.ushell": {}
      }
    },
    "contentDensities": { "compact": true, "cozy": true },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": { "bundleName": "kejriwal.plant.dashboard.i18n.i18n" }
      }
    },
    "rootView": {
      "viewName": "kejriwal.plant.dashboard.view.Dashboard",
      "type": "XML",
      "id": "dashboard",
      "height": "100%"
    }
  }
}
