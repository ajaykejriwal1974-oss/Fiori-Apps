<mvc:View
    controllerName="kejriwal.pp.postpackinggr.controller.Worklist"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">
    <Page id="page" title="{i18n>appTitle}">
        <subHeader>
            <!-- Filter-first worklist: the binding below starts SUSPENDED, so the app no
                 longer loads (and $count-s) the ENTIRE entity set on first paint - rows
                 appear when the user presses Go with a filter (or none, explicitly). -->
            <OverflowToolbar id="filterBar">
                <Label text="{i18n>colHandlingUnit}"/>
                <Input id="inpHandlingUnit" width="10rem" submit=".onFilterSearch"/>
                <Label text="{i18n>colReference}"/>
                <Input id="inpReference" width="10rem" submit=".onFilterSearch"/>
                <ToolbarSpacer/>
                <Button id="btnGo" text="Go" type="Emphasized" press=".onFilterSearch"/>
            </OverflowToolbar>
        </subHeader>
        <content>
            <Table sticky="ColumnHeaders,HeaderToolbar"
                id="table"
                items="{ path: '/PostPackGr', suspended: true }"
                mode="MultiSelect"
                growing="true"
                growingThreshold="50">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="{i18n>worklistTitle}"/>
                        <ToolbarSpacer/>
                        <Button text="{i18n>actpostPackingAndGr}" press=".onPostPackingAndGr" type="Emphasized"/>
                        <Button icon="sap-icon://sort" tooltip="Sort" press=".onOpenSort"/>
                        <Button icon="sap-icon://excel-attachment" tooltip="Export to Excel" press=".onExportExcel"/>
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                        <Column><Text text="{i18n>colHandlingUnit}"/></Column>
                        <Column><Text text="{i18n>colPackagingMaterial}"/></Column>
                        <Column><Text text="{i18n>colReference}"/></Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{HandlingUnit}"/>
                            <Text text="{PackagingMaterial}"/>
                            <Text text="{Reference}"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>
