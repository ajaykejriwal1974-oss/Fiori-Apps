<mvc:View
    controllerName="kejriwal.pp.wipbatchclose.controller.Worklist"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    displayBlock="true"
    height="100%">

    <!-- DynamicPage: the filter fields wrap over as many rows as needed instead
         of collapsing into an overflow menu, and Go stays pinned in the title. -->
    <f:DynamicPage id="page" headerExpanded="true" toggleHeaderOnTitleClick="true" fitContent="true">

        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>appTitle}"/>
                </f:heading>
                <f:actions>
                    <Button id="btnGo" text="Go" type="Emphasized" press=".onFilterSearch"/>
                    <Button id="btnClear" text="Clear" press=".onClearFilters"/>
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <form:SimpleForm
                    id="filterForm"
                    editable="true"
                    layout="ResponsiveGridLayout"
                    labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
                    columnsXL="4" columnsL="3" columnsM="2"
                    singleContainerFullSize="false">

                    <Label text="{i18n>colCompanyCode}"/>
                    <Input id="inpCompanyCode" submit=".onFilterSearch" showValueHelp="true" valueHelpRequest=".onCompanyCodeVH"/>

                    <Label text="{i18n>colPlant}"/>
                    <Input id="inpPlant" submit=".onFilterSearch" showValueHelp="true" valueHelpRequest=".onPlantVH"/>

                    <Label text="{i18n>colBatch}"/>
                    <Input id="inpBatch" submit=".onFilterSearch"/>

                    <Label text="{i18n>colOrder}"/>
                    <Input id="inpProductionOrder" submit=".onFilterSearch"/>

                    <Label text="{i18n>colGrey}"/>
                    <Input id="inpGreyMaterial" submit=".onFilterSearch" showValueHelp="true" valueHelpRequest=".onGreyVH"/>

                    <Label text="{i18n>colDyed}"/>
                    <Input id="inpDyedMaterial" submit=".onFilterSearch" showValueHelp="true" valueHelpRequest=".onDyedVH"/>

                    <Label text="{i18n>filterBatchFrom}"/>
                    <DatePicker id="dpBatchDateFrom" valueFormat="yyyy-MM-dd" displayFormat="short"/>

                    <Label text="{i18n>filterBatchTo}"/>
                    <DatePicker id="dpBatchDateTo" valueFormat="yyyy-MM-dd" displayFormat="short"/>

                    <Label text="{i18n>colClosed}"/>
                    <Select id="selClosed">
                        <core:Item key="" text="{i18n>statusAll}"/>
                        <core:Item key="OPEN" text="{i18n>statusOpen}"/>
                        <core:Item key="CLOSED" text="{i18n>statusClosed}"/>
                    </Select>
                </form:SimpleForm>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <Table sticky="ColumnHeaders,HeaderToolbar"
                id="table"
                items="{ path: '/WipBatch', suspended: true }"
                mode="MultiSelect"
                growing="true"
                growingThreshold="50"
                growingScrollToLoad="true">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="{i18n>worklistTitle}"/>
                        <ToolbarSpacer/>
                        <Button text="{i18n>actcloseBatches}" press=".onCloseBatches" type="Emphasized" icon="sap-icon://locked"/>
                        <Button text="{i18n>actreopenBatches}" press=".onReopenBatches" type="Reject" icon="sap-icon://unlocked"/>
                        <SearchField width="14rem" search=".onQuickSearch" placeholder="Search"/>
                        <Button icon="sap-icon://sort" tooltip="Sort" press=".onOpenSort"/>
                        <Button icon="sap-icon://excel-attachment" tooltip="Export to Excel" press=".onExportExcel"/>
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column><Text text="{i18n>colBatch}"/></Column>
                    <Column><Text text="{i18n>colFiscalYear}"/></Column>
                    <Column><Text text="{i18n>colPlant}"/></Column>
                    <Column><Text text="{i18n>colOrder}"/></Column>
                    <Column><Text text="{i18n>colBatchDate}"/></Column>
                    <Column><Text text="{i18n>colGrey}"/></Column>
                    <Column><Text text="{i18n>colDyed}"/></Column>
                    <Column hAlign="End"><Text text="{i18n>colQuantity}"/></Column>
                    <Column><Text text="{i18n>colUnit}"/></Column>
                    <Column hAlign="End"><Text text="{i18n>colCheeses}"/></Column>
                    <Column><Text text="{i18n>colAssigned}"/></Column>
                    <Column><Text text="{i18n>colClosed}"/></Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{Batch}"/>
                            <Text text="{FiscalYear}"/>
                            <Text text="{Plant}"/>
                            <Text text="{ProductionOrder}"/>
                            <Text text="{BatchDate}"/>
                            <Text text="{GreyMaterial}"/>
                            <Text text="{DyedMaterial}"/>
                            <Text text="{Quantity}"/>
                            <Text text="{BatchUnit}"/>
                            <Text text="{Cheeses}"/>
                            <Text text="{Assigned}"/>
                            <ObjectStatus
                                text="{= ${Closed} === 'X' ? ${i18n>statusClosed} : ${i18n>statusOpen} }"
                                state="{= ${Closed} === 'X' ? 'Warning' : 'Success' }"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </f:content>

    </f:DynamicPage>
</mvc:View>
