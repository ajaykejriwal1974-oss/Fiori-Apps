{
  "name": "kejriwal-wip-batch-close",
  "version": "1.0.0",
  "private": true,
  "description": "Custom Fiori app to close and reopen dyeing WIP batches; clean-core replacement for zbatch_cls.",
  "keywords": ["ui5", "freestyle", "sap-fiori", "s4hana-onpremise"],
  "scripts": {
    "start": "ui5 serve --open \"index.html\"",
    "build": "ui5 build --clean-dest",
    "deploy": "npm run build && fiori deploy"
  },
  "devDependencies": {
    "@sap/ux-ui5-tooling": "1",
    "@ui5/cli": "^3"
  },
  "ui5": { "dependencies": ["@sap/ux-ui5-tooling"] }
}
