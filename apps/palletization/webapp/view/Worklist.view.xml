<mvc:View
    controllerName="kejriwal.pp.palletization.controller.Worklist"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">
    <Page id="page" title="{i18n>appTitle}">
        <subHeader>
            <!-- Filter-first worklist: the binding below starts SUSPENDED, so the app no
                 longer loads (and $count-s) the ENTIRE entity set on first paint - rows
                 appear when the user presses Go with a filter (or none, explicitly). -->
            <OverflowToolbar id="filterBar">
                <Label text="{i18n>colPallet}"/>
                <Input id="inpPallet" width="10rem" submit=".onFilterSearch"/>
                <Label text="{i18n>colReference}"/>
                <Input id="inpReference" width="10rem" submit=".onFilterSearch"/>
                <ToolbarSpacer/>
                <Button id="btnGo" text="Go" type="Emphasized" press=".onFilterSearch"/>
            </OverflowToolbar>
        </subHeader>
        <content>
            <Table
                id="table"
                items="{ path: '/Pallet', suspended: true }"
                mode="MultiSelect"
                growing="true"
                growingThreshold="50">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="{i18n>worklistTitle}"/>
                        <ToolbarSpacer/>
                        <Button text="{i18n>actpackPallet}" press=".onPackPallet" type="Emphasized"/>
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                        <Column><Text text="{i18n>colPallet}"/></Column>
                        <Column><Text text="{i18n>colPackagingMaterial}"/></Column>
                        <Column><Text text="{i18n>colReference}"/></Column>
                        <Column><Text text="{i18n>colNetWeight}"/></Column>
                        <Column><Text text="{i18n>colWeightUnit}"/></Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{Pallet}"/>
                            <Text text="{PackagingMaterial}"/>
                            <Text text="{Reference}"/>
                            <Text text="{NetWeight}"/>
                            <Text text="{WeightUnit}"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>
