{
  "_version": "1.60.0",
  "sap.app": {
    "id": "kejriwal.pp.jobcardreport",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_jobcard_report_04/srvd/sap/zui_jobcard_report/0001/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "JobCardReport-display": {
          "semanticObject": "JobCardReport",
          "action": "display",
          "icon": "sap-icon://activity-items",
          "title": "{{flpTitle}}",
          "subTitle": "{{flpSubtitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "fullWidth": true,
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "kejriwal.pp.jobcardreport.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "routes": [
        {
          "pattern": ":?query:",
          "name": "JobCardList",
          "target": "JobCardList"
        },
        {
          "pattern": "JobCard({key}):?query:",
          "name": "JobCardObjectPage",
          "target": "JobCardObjectPage"
        }
      ],
      "targets": {
        "JobCardList": {
          "type": "Component",
          "id": "JobCardList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/JobCard",
              "variantManagement": "Page",
              "initialLoad": "Auto",
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "GridTable",
                    "rowCountMode": "Auto",
                    "selectionMode": "Single",
                    "personalization": true,
                    "condensedTableLayout": true,
                    "enableExport": true
                  },
                  "actions": {
                    "CreateJobCard": {
                      "press": "kejriwal.pp.jobcardreport.ext.Actions.onCreateJobCard",
                      "text": "{i18n>createJobCard}",
                      "enabled": true,
                      "position": {
                        "placement": "After"
                      }
                    },
                    "PrintJobCard": {
                      "press": "kejriwal.pp.jobcardreport.ext.Actions.onPrintJobCard",
                      "text": "{i18n>printJobCard}",
                      "requiresSelection": true,
                      "enabled": true,
                      "position": {
                        "placement": "After",
                        "anchor": "CreateJobCard"
                      }
                    }
                  }
                }
              },
              "navigation": {
                "JobCard": {
                  "detail": {
                    "route": "JobCardObjectPage"
                  }
                }
              }
            }
          }
        },
        "JobCardObjectPage": {
          "type": "Component",
          "id": "JobCardObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/JobCard",
              "editableHeaderContent": false
            }
          }
        }
      }
    }
  }
}
