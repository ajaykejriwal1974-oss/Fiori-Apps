<mvc:View
    controllerName="kejriwal.qm.qcrawmaterial.controller.Worklist"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    xmlns:form="sap.ui.layout.form"
    height="100%">

    <f:DynamicPage id="page" headerExpanded="true" fitContent="true">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading><Title text="Raw Material QC" level="H2"/></f:heading>
                <f:expandedContent>
                    <Text text="Incoming greige yarn - inspected per supplier delivery lot"/>
                </f:expandedContent>
                <f:actions>
                    <Button text="{i18n>go}" type="Emphasized" press=".onGo" class="sapUiTinyMarginEnd"/>
                    <Button text="{i18n>clear}" press=".onClear"/>
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <form:SimpleForm layout="ResponsiveGridLayout" columnsXL="4" columnsL="3" columnsM="2" editable="true">
                    <Label text="Search"/>
                    <SearchField id="fSearch" placeholder="Supplier lot, material" search=".onGo" width="100%"/>
                    <Label text="Supplier Lot"/>
                    <Input id="fVendorBatch" width="100%"/>
                    <Label text="Material"/>
                    <Input id="fMaterial" width="100%"/>
                    <Label text="Plant"/>
                    <Input id="fPlant" width="100%" showValueHelp="true" valueHelpRequest=".onPlantVH"/>
                    <Label text="Received From"/>
                    <DatePicker id="fDateFrom" width="100%" valueFormat="yyyy-MM-dd"/>
                    <Label text="Open only"/>
                    <Switch id="fOpenOnly" state="true"/>
                </form:SimpleForm>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <Table id="tblLots" growing="true" growingThreshold="40" growingScrollToLoad="true"
                   sticky="ColumnHeaders" mode="None"
                   items="{ path: '/InspectionLot', parameters: { $count: true }, suspended: true }">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="Deliveries awaiting inspection" level="H3"/>
                        <ToolbarSpacer/><Text id="txtCount"/>
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column><Text text="Supplier Lot"/></Column>
                    <Column><Text text="Material"/></Column>
                    <Column minScreenWidth="Tablet" demandPopin="true" hAlign="End"><Text text="Delivered"/></Column>
                    <Column minScreenWidth="Tablet" demandPopin="true" hAlign="End"><Text text="Sample"/></Column>
                    <Column minScreenWidth="Tablet" demandPopin="true"><Text text="Received"/></Column>
                    <Column hAlign="End"><Text text="Status"/></Column>
                </columns>
                <items>
                    <ColumnListItem type="Navigation" press=".onOpenLot">
                        <cells>
                            <VBox>
                                <Text text="{VendorBatch}" class="sapMTitleStyleH5"/>
                                <Text text="{InspectionLot}" class="sapUiTinyText"/>
                            </VBox>
                            <VBox>
                                <Text text="{MaterialName}"/>
                                <Text text="{Material}" class="sapUiTinyText"/>
                            </VBox>
                            <Text text="{ parts: ['LotQuantity','LotUnit'], formatter: '.fmtQty' }"/>
                            <Text text="{ parts: ['SampleSize','SampleUnit'], formatter: '.fmtQty' }"/>
                            <Text text="{ path: 'CreatedOn', type: 'sap.ui.model.odata.type.Date', formatOptions: { style: 'medium' } }"/>
                            <ObjectStatus text="{ path: 'ResultsConfirmed', formatter: '.fmtStatusText' }"
                                          state="{ path: 'ResultsConfirmed', formatter: '.fmtStatusState' }"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </f:content>
    </f:DynamicPage>
</mvc:View>
