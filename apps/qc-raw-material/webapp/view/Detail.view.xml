<mvc:View
    controllerName="kejriwal.qm.qcrawmaterial.controller.Detail"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    xmlns:form="sap.ui.layout.form"
    height="100%">

    <f:DynamicPage id="detailPage" headerExpanded="true" showFooter="true" fitContent="true">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading><Title text="{VendorBatch}" level="H2"/></f:heading>
                <f:expandedContent><Text text="{MaterialName} - {Material}"/></f:expandedContent>
                <f:navigationActions>
                    <Button icon="sap-icon://nav-back" press=".onBack"/>
                </f:navigationActions>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <HBox wrap="Wrap">
                    <ObjectAttribute title="Inspection Lot" text="{InspectionLot}" class="sapUiMediumMarginEnd"/>
                    <ObjectAttribute title="Delivered" text="{ parts: ['LotQuantity','LotUnit'], formatter: '.fmtQty' }" class="sapUiMediumMarginEnd"/>
                    <ObjectAttribute title="Sample" text="{ parts: ['SampleSize','SampleUnit'], formatter: '.fmtQty' }" class="sapUiMediumMarginEnd"/>
                    <ObjectAttribute title="Received" text="{ path: 'CreatedOn', type: 'sap.ui.model.odata.type.Date' }"/>
                </HBox>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <VBox>

                <!-- Single-lot rule. Loading one dye vessel from two supplier
                     lots is the most reliable way to produce barre in
                     polyester, and this plant has a Merge Details app, so
                     merging is a recognised operation here. -->
                <MessageStrip
                    text="Single-lot loading: confirm this delivery will not be blended with another supplier lot before dyeing."
                    type="Warning" showIcon="true" class="sapUiSmallMargin"/>

                <!-- Boiling water shrinkage gets its own panel because it is
                     doing double duty. The dye uniformity tube test was cut
                     from the specification, and BWS spread across packages is
                     the accepted proxy for dye affinity spread. The RANGE is
                     the number that matters, not the mean. -->
                <Panel headerText="Boiling water shrinkage - 5 packages" expandable="true" expanded="true"
                       class="sapUiSmallMarginBeginEnd">
                    <content>
                        <VBox class="sapUiSmallMargin">
                            <Text text="ASTM D2259, 100 C / 30 min. Take one specimen from each of five packages in different cartons. Spread matters more than the mean - it is the substitute for the dye uniformity test."
                                  class="sapUiTinyText sapUiSmallMarginBottom"/>
                            <HBox wrap="Wrap" id="bwsBox">
                                <VBox class="sapUiSmallMarginEnd">
                                    <Label text="Pkg 1"/><Input id="bws1" type="Number" width="6rem" textAlign="End" change=".onBwsChange"/>
                                </VBox>
                                <VBox class="sapUiSmallMarginEnd">
                                    <Label text="Pkg 2"/><Input id="bws2" type="Number" width="6rem" textAlign="End" change=".onBwsChange"/>
                                </VBox>
                                <VBox class="sapUiSmallMarginEnd">
                                    <Label text="Pkg 3"/><Input id="bws3" type="Number" width="6rem" textAlign="End" change=".onBwsChange"/>
                                </VBox>
                                <VBox class="sapUiSmallMarginEnd">
                                    <Label text="Pkg 4"/><Input id="bws4" type="Number" width="6rem" textAlign="End" change=".onBwsChange"/>
                                </VBox>
                                <VBox class="sapUiSmallMarginEnd">
                                    <Label text="Pkg 5"/><Input id="bws5" type="Number" width="6rem" textAlign="End" change=".onBwsChange"/>
                                </VBox>
                            </HBox>
                            <HBox class="sapUiSmallMarginTop" alignItems="Center">
                                <ObjectStatus id="bwsMean"  title="Mean"  class="sapUiMediumMarginEnd"/>
                                <ObjectStatus id="bwsRange" title="Range (limit 1.5)" class="sapMObjectStatusLarge"/>
                            </HBox>
                        </VBox>
                    </content>
                </Panel>

                <!-- Everything else, driven from the characteristics the
                     inspection plan actually carries. -->
                <List id="lstChars" mode="None" headerText="Characteristics"
                      items="{ path: '_Characteristic', parameters: { $$updateGroupId: 'qc' } }"
                      class="sapUiSmallMarginBeginEnd">
                    <CustomListItem>
                        <VBox class="sapUiSmallMargin">
                            <HBox justifyContent="SpaceBetween" alignItems="Center">
                                <VBox>
                                    <Text text="{CharacteristicName}" class="sapMTitleStyleH5"/>
                                    <Text text="{ parts: ['MasterCharacteristic','TargetValue','LowerLimit','UpperLimit','CharacteristicUnit','LowerLimitIsInitial','UpperLimitIsInitial'], formatter: '.fmtSpec' }"
                                          class="sapUiTinyText"/>
                                </VBox>
                                <ObjectStatus text="{ path: 'Valuation', formatter: '.fmtValText' }"
                                              state="{ path: 'Valuation', formatter: '.fmtValState' }"
                                              class="sapMObjectStatusLarge"/>
                            </HBox>

                            <HBox class="sapUiSmallMarginTop" alignItems="Center"
                                  visible="{= ${CharacteristicKind} === 'QUAN' }">
                                <Input value="{MeanValue}" type="Number" width="9rem" textAlign="End" change=".onResultChange"/>
                                <Text text="{CharacteristicUnit}" class="sapUiSmallMarginBegin"/>
                            </HBox>

                            <!-- Grade is the only coded characteristic at this
                                 stage. Three buttons, not a dropdown. -->
                            <SegmentedButton class="sapUiSmallMarginTop"
                                             selectedKey="{ResultCode}" selectionChange=".onCodeChange"
                                             visible="{= ${SelectedSet} === 'ZQC_GRADE' }">
                                <items>
                                    <SegmentedButtonItem key="AA" text="AA"/>
                                    <SegmentedButtonItem key="A"  text="A"/>
                                    <SegmentedButtonItem key="B"  text="B"/>
                                </items>
                            </SegmentedButton>

                            <!-- Attribute: defect count over the ISO 2859-1
                                 sample, one entry, not one per package. -->
                            <HBox class="sapUiSmallMarginTop" alignItems="Center"
                                  visible="{= ${SelectedSet} === 'ZQC_PF' }">
                                <Label text="Defectives found" class="sapUiTinyMarginEnd"/>
                                <StepInput value="{DefectCount}" min="0" step="1" width="7rem" change=".onResultChange"/>
                                <Label text="of sample" class="sapUiSmallMarginBegin sapUiTinyMarginEnd"/>
                                <StepInput value="{ActualSampleSize}" min="0" step="1" width="7rem" change=".onResultChange"/>
                            </HBox>
                        </VBox>
                    </CustomListItem>
                </List>
            </VBox>
        </f:content>

        <f:footer>
            <OverflowToolbar>
                <ToolbarSpacer/>
                <!-- __OperationControl comes back with every InspectionLot read
                     (get_global_authorizations sets it per lot) - gate each
                     button on its own flag so a closed lot or an existing UD
                     disables the button instead of surfacing a raw OData error. -->
                <Button text="Save" press=".onSave"
                        enabled="{= ${ui>/dirty} &amp;&amp; ${__OperationControl/recordSingleResult} }"/>
                <Button text="Record Results" type="Emphasized" press=".onRecord"
                        enabled="{__OperationControl/recordResults}"/>
                <Button text="Usage Decision" type="Attention" press=".onUsageDecision"
                        enabled="{__OperationControl/setUsageDecision}"/>
            </OverflowToolbar>
        </f:footer>
    </f:DynamicPage>
</mvc:View>
