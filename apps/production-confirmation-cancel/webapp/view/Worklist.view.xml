<mvc:View
    controllerName="kejriwal.pp.prodconfcancel.controller.Worklist"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    displayBlock="true"
    height="100%">

    <!-- DynamicPage, not Page+OverflowToolbar. The nine filter fields no longer
         collapse into a "..." menu that hid the Go button: the header wraps them
         over as many rows as the window needs, and Go lives in the title bar,
         which stays pinned while the table scrolls. -->
    <f:DynamicPage id="page" headerExpanded="true" toggleHeaderOnTitleClick="true" fitContent="true">

        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>appTitle}"/>
                </f:heading>
                <f:actions>
                    <Button id="btnGo" text="Go" type="Emphasized" press=".onFilterSearch"/>
                    <Button id="btnClear" text="Clear" press=".onClearFilters"/>
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <form:SimpleForm
                    id="filterForm"
                    editable="true"
                    layout="ResponsiveGridLayout"
                    labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
                    columnsXL="4" columnsL="3" columnsM="2"
                    singleContainerFullSize="false">

                    <Label text="{i18n>colCompanyCode}"/>
                    <Input id="inpCompanyCode" submit=".onFilterSearch" showValueHelp="true" valueHelpRequest=".onCompanyCodeVH"/>

                    <Label text="{i18n>colPlant}"/>
                    <Input id="inpPlant" submit=".onFilterSearch" showValueHelp="true" valueHelpRequest=".onPlantVH"/>

                    <Label text="{i18n>colOrder}"/>
                    <Input id="inpOrderNumber" submit=".onFilterSearch"/>

                    <Label text="{i18n>colOperation}"/>
                    <Input id="inpOperationNumber" submit=".onFilterSearch"/>

                    <Label text="{i18n>colMaterial}"/>
                    <Input id="inpMaterial" submit=".onFilterSearch" showValueHelp="true" valueHelpRequest=".onMaterialVH"/>

                    <Label text="{i18n>colCreatedBy}"/>
                    <Input id="inpCreatedBy" submit=".onFilterSearch" showValueHelp="true" valueHelpRequest=".onCreatedByVH"/>

                    <Label text="{i18n>filterPostingFrom}"/>
                    <DatePicker id="dpPostingDateFrom" valueFormat="yyyy-MM-dd" displayFormat="short"/>

                    <Label text="{i18n>filterPostingTo}"/>
                    <DatePicker id="dpPostingDateTo" valueFormat="yyyy-MM-dd" displayFormat="short"/>

                    <Label text=""/>
                    <CheckBox id="cbHideCancelled" text="{i18n>filterHideCancelled}" selected="true"/>
                </form:SimpleForm>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <Table sticky="ColumnHeaders,HeaderToolbar"
                id="table"
                items="{ path: '/ProdConfirmation', suspended: true }"
                mode="MultiSelect"
                growing="true"
                growingThreshold="50"
                growingScrollToLoad="true">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="{i18n>worklistTitle}"/>
                        <ToolbarSpacer/>
                        <Button text="{i18n>actcancelConfirmations}" press=".onCancelConfirmations" type="Reject" icon="sap-icon://undo"/>
                        <SearchField width="14rem" search=".onQuickSearch" placeholder="Search"/>
                        <Button icon="sap-icon://sort" tooltip="Sort" press=".onOpenSort"/>
                        <Button icon="sap-icon://excel-attachment" tooltip="Export to Excel" press=".onExportExcel"/>
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column><Text text="{i18n>colConfirmation}"/></Column>
                    <Column><Text text="{i18n>colCounter}"/></Column>
                    <Column><Text text="{i18n>colOrder}"/></Column>
                    <Column><Text text="{i18n>colOperation}"/></Column>
                    <Column><Text text="{i18n>colPlant}"/></Column>
                    <Column><Text text="{i18n>colMaterial}"/></Column>
                    <Column><Text text="{i18n>colPostingDate}"/></Column>
                    <Column hAlign="End"><Text text="{i18n>colYield}"/></Column>
                    <Column hAlign="End"><Text text="{i18n>colScrap}"/></Column>
                    <Column><Text text="{i18n>colUnit}"/></Column>
                    <Column><Text text="{i18n>colCancelled}"/></Column>
                    <Column><Text text="{i18n>colCreatedBy}"/></Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{ConfirmationNumber}"/>
                            <Text text="{ConfirmationCounter}"/>
                            <Text text="{OrderNumber}"/>
                            <Text text="{OperationNumber}"/>
                            <Text text="{Plant}"/>
                            <Text text="{Material}"/>
                            <Text text="{PostingDate}"/>
                            <Text text="{YieldQuantity}"/>
                            <Text text="{ScrapQuantity}"/>
                            <Text text="{ConfirmationUnit}"/>
                            <ObjectStatus text="{= ${IsCancelled} === 'X' ? 'Cancelled' : '' }" state="Error"/>
                            <Text text="{CreatedBy}"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </f:content>

    </f:DynamicPage>
</mvc:View>
