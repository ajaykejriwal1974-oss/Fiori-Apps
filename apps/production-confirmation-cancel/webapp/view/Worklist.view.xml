<mvc:View
    controllerName="kejriwal.pp.prodconfcancel.controller.Worklist"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">
    <Page id="page" title="{i18n>appTitle}">
        <subHeader>
            <!-- Filter-first worklist: the table binding starts SUSPENDED, so the app
                 never loads (and $count-s) the whole AFRU-based entity set on first
                 paint. Rows appear only once the user presses Go. -->
            <OverflowToolbar id="filterBar">
                <Label text="{i18n>colCompanyCode}"/>
                <Input id="inpCompanyCode" width="8rem" submit=".onFilterSearch" showValueHelp="true" valueHelpRequest=".onCompanyCodeVH"/>
                <Label text="{i18n>colPlant}"/>
                <Input id="inpPlant" width="8rem" submit=".onFilterSearch" showValueHelp="true" valueHelpRequest=".onPlantVH"/>
                <Label text="{i18n>colOrder}"/>
                <Input id="inpOrderNumber" width="10rem" submit=".onFilterSearch"/>
                <Label text="{i18n>colOperation}"/>
                <Input id="inpOperationNumber" width="6rem" submit=".onFilterSearch"/>
                <Label text="{i18n>colMaterial}"/>
                <Input id="inpMaterial" width="10rem" submit=".onFilterSearch" showValueHelp="true" valueHelpRequest=".onMaterialVH"/>
                <Label text="{i18n>colPostingDate}"/>
                <DatePicker id="dpPostingDateFrom" width="9rem" valueFormat="yyyy-MM-dd" displayFormat="short" change=".onFilterSearch"/>
                <Label text="-"/>
                <DatePicker id="dpPostingDateTo" width="9rem" valueFormat="yyyy-MM-dd" displayFormat="short" change=".onFilterSearch"/>
                <Label text="{i18n>colCreatedBy}"/>
                <Input id="inpCreatedBy" width="8rem" submit=".onFilterSearch" showValueHelp="true" valueHelpRequest=".onCreatedByVH"/>
                <CheckBox id="cbHideCancelled" text="Hide cancelled" selected="true" select=".onFilterSearch"/>
                <ToolbarSpacer/>
                <Button id="btnGo" text="Go" type="Emphasized" press=".onFilterSearch"/>
            </OverflowToolbar>
        </subHeader>
        <content>
            <Table sticky="ColumnHeaders,HeaderToolbar"
                id="table"
                items="{ path: '/ProdConfirmation', suspended: true }"
                mode="MultiSelect"
                growing="true"
                growingThreshold="50">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="{i18n>worklistTitle}"/>
                        <ToolbarSpacer/>
                        <Button text="{i18n>actcancelConfirmations}" press=".onCancelConfirmations" type="Reject" icon="sap-icon://undo"/>
                        <SearchField width="14rem" search=".onQuickSearch" placeholder="Search"/>
                        <Button icon="sap-icon://sort" tooltip="Sort" press=".onOpenSort"/>
                        <Button icon="sap-icon://excel-attachment" tooltip="Export to Excel" press=".onExportExcel"/>
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column><Text text="{i18n>colConfirmation}"/></Column>
                    <Column><Text text="{i18n>colCounter}"/></Column>
                    <Column><Text text="{i18n>colOrder}"/></Column>
                    <Column><Text text="{i18n>colOperation}"/></Column>
                    <Column><Text text="{i18n>colPlant}"/></Column>
                    <Column><Text text="{i18n>colMaterial}"/></Column>
                    <Column><Text text="{i18n>colPostingDate}"/></Column>
                    <Column hAlign="End"><Text text="{i18n>colYield}"/></Column>
                    <Column hAlign="End"><Text text="{i18n>colScrap}"/></Column>
                    <Column><Text text="{i18n>colUnit}"/></Column>
                    <Column><Text text="{i18n>colCancelled}"/></Column>
                    <Column><Text text="{i18n>colCreatedBy}"/></Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{ConfirmationNumber}"/>
                            <Text text="{ConfirmationCounter}"/>
                            <Text text="{OrderNumber}"/>
                            <Text text="{OperationNumber}"/>
                            <Text text="{Plant}"/>
                            <Text text="{Material}"/>
                            <Text text="{PostingDate}"/>
                            <Text text="{YieldQuantity}"/>
                            <Text text="{ScrapQuantity}"/>
                            <Text text="{ConfirmationUnit}"/>
                            <ObjectStatus text="{= ${IsCancelled} === 'X' ? 'Cancelled' : '' }" state="Error"/>
                            <Text text="{CreatedBy}"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>
