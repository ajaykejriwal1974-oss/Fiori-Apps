<mvc:View
    controllerName="kejriwal.qm.inspectionresultmass.controller.Worklist"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">
    <Page id="page" title="{i18n>worklistTitle}" showHeader="true">
        <subHeader>
            <!-- Work Centre was a filter here once. The service has no such
                 property (ZC_QM_INSPECTIONCHAR is QAMV + QALS, and the
                 operation's work centre lives in the plan, not on the lot), so
                 typing one produced an OData 400 and an empty table. Inspection
                 type replaces it - that is how the stage apps scope their lots. -->
            <OverflowToolbar id="filterBar">
                <Label text="{i18n>plant}" labelFor="inpPlant"/>
                <Input id="inpPlant" width="6rem" maxLength="4" value="{ui>/filter/plant}" submit=".onSearch"/>
                <Label text="{i18n>material}" labelFor="inpMaterial"/>
                <Input id="inpMaterial" width="12rem" maxLength="40" value="{ui>/filter/material}" submit=".onSearch"/>
                <Label text="{i18n>inspLot}" labelFor="inpLot"/>
                <Input id="inpLot" width="10rem" maxLength="12" value="{ui>/filter/inspectionLot}" submit=".onSearch"/>
                <Label text="{i18n>inspType}" labelFor="inpType"/>
                <Input id="inpType" width="4rem" maxLength="2" value="{ui>/filter/inspectionType}" submit=".onSearch"/>
                <ToolbarSpacer />
                <Button id="btnSearch" text="{i18n>search}" type="Emphasized" press=".onSearch" />
            </OverflowToolbar>
        </subHeader>
        <content>
            <!-- suspended: nothing is read until Go. The service returns every
                 characteristic of every lot without a usage decision, so an
                 unfiltered read on open would be the whole plant's backlog. -->
            <Table
                id="resultsTable"
                items="{
                    path: '/InspectionCharacteristic',
                    parameters: { '$count': true },
                    suspended: true
                }"
                mode="None"
                growing="true"
                growingThreshold="100"
                noDataText="{= ${ui>/hasResult} ? ${i18n>noRows} : ${i18n>pressGo} }"
                sticky="ColumnHeaders,HeaderToolbar">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="{i18n>charsToRecord}" level="H2" />
                        <ToolbarSpacer />
                        <ObjectStatus id="dirtyStatus" text="{ui>/dirtyCount} {i18n>edited}" state="Information" visible="{= ${ui>/dirtyCount} &gt; 0 }" />
                        <Button icon="sap-icon://sort" tooltip="{i18n>sort}" press=".onOpenSort"/>
                        <Button icon="sap-icon://excel-attachment" tooltip="{i18n>export}" press=".onExportExcel"/>
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column width="9rem"><Text text="{i18n>inspLot}" /></Column>
                    <Column width="9rem"><Text text="{i18n>material}" /></Column>
                    <Column><Text text="{i18n>characteristic}" /></Column>
                    <Column width="10rem" hAlign="End"><Text text="{i18n>resultValue}" /></Column>
                    <Column width="6rem"><Text text="{i18n>unit}" /></Column>
                    <Column width="10rem"><Text text="{i18n>valuation}" /></Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <VBox>
                                <Text text="{InspectionLot}" />
                                <Text text="{Plant} · {InspectionType}" class="sapUiTinyText"/>
                            </VBox>
                            <Text text="{Material}" />
                            <Text text="{CharacteristicDescription}" />
                            <Input
                                value="{ResultValue}"
                                type="Number"
                                textAlign="End"
                                change=".onResultChange" />
                            <Text text="{Unit}" />
                            <Select selectedKey="{Valuation}" change=".onResultChange">
                                <core:Item key="" text="" />
                                <core:Item key="A" text="{i18n>accept}" />
                                <core:Item key="R" text="{i18n>reject}" />
                            </Select>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
        <footer>
            <OverflowToolbar>
                <ToolbarSpacer />
                <Button
                    id="btnPost"
                    text="{i18n>postResults}"
                    type="Emphasized"
                    icon="sap-icon://accept"
                    enabled="{= ${ui>/dirtyCount} &gt; 0 }"
                    press=".onPostResults" />
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>
