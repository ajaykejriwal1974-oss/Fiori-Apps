{
  "_version": "1.65.0",
  "sap.app": {
    "id": "com.kgpl.zpalletstock",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": { "version": "1.0.0" },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_pallet_stock_04/srvd/sap/zui_pallet_stock/0001/",
        "type": "OData",
        "settings": { "odataVersion": "4.0" }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "PalletStock-display": {
          "semanticObject": "PalletStock",
          "action": "display",
          "title": "{{appTitle}}",
          "subTitle": "{{appSubTitle}}",
          "icon": "sap-icon://pallet",
          "signature": { "parameters": {}, "additionalParameters": "allowed" }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": { "icon": "sap-icon://pallet" },
    "deviceTypes": { "desktop": true, "tablet": true, "phone": true }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": { "sap.m": {}, "sap.ui.core": {}, "sap.fe.templates": {} }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": { "bundleName": "com.kgpl.zpalletstock.i18n.i18n" }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": { "operationMode": "Server", "autoExpandSelect": true, "earlyRequests": true }
      }
    },
    "routing": {
      "config": {},
      "routes": [
        { "pattern": ":?query:", "name": "PalletStockList", "target": "PalletStockList" },
        { "pattern": "PalletStock({key}):?query:", "name": "PalletStockOP", "target": "PalletStockOP" }
      ],
      "targets": {
        "PalletStockList": {
          "type": "Component",
          "id": "PalletStockList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/PalletStock",
              "variantManagement": "Page",
              "initialLoad": "Disabled",
              "navigation": { "PalletStock": { "detail": { "route": "PalletStockOP" } } }
            }
          }
        },
        "PalletStockOP": {
          "type": "Component",
          "id": "PalletStockOP",
          "name": "sap.fe.templates.ObjectPage",
          "options": { "settings": { "contextPath": "/PalletStock" } }
        }
      }
    },
    "contentDensities": { "compact": true, "cozy": true }
  },
  "sap.fiori": { "registrationIds": [], "archeType": "transactional" }
}
