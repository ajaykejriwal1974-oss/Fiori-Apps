<mvc:View
    controllerName="kejriwal.pp.mtosprocess.controller.Worklist"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">
    <Page id="page" title="{i18n>appTitle}">
        <subHeader>
            <!-- Filter-first worklist: the binding below starts SUSPENDED, so the app no
                 longer loads (and $count-s) the ENTIRE entity set on first paint - rows
                 appear when the user presses Go with a filter (or none, explicitly). -->
            <OverflowToolbar id="filterBar">
                <Label text="Company"/>
                <Input id="inpCompanyCode" width="9rem" submit=".onFilterSearch" showValueHelp="true" valueHelpRequest=".onCompanyCodeVH"/>
                <Label text="{i18n>colPlant}"/>
                <Input id="inpPlant" width="10rem" submit=".onFilterSearch" showValueHelp="true" valueHelpRequest=".onPlantVH"/>
                <Label text="{i18n>colMaterial}"/>
                <Input id="inpMaterial" width="10rem" submit=".onFilterSearch" showValueHelp="true" valueHelpRequest=".onMaterialVH"/>
                <Label text="{i18n>colSalesOrder}"/>
                <Input id="inpSalesOrder" width="10rem" submit=".onFilterSearch" showValueHelp="true" valueHelpRequest=".onSalesOrderVH"/>
                <ToolbarSpacer/>
                <Button id="btnGo" text="Go" type="Emphasized" press=".onFilterSearch"/>
            </OverflowToolbar>
        </subHeader>
        <content>
            <Table
                id="table"
                items="{ path: '/MtosStock', suspended: true }"
                mode="MultiSelect"
                growing="true"
                growingThreshold="50">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="{i18n>worklistTitle}"/>
                        <ToolbarSpacer/>
                        <Button text="{i18n>actconvertToMts}" press=".onConvertToMts" type="Emphasized"/>
                        <Button text="{i18n>actcreatePhysInvDoc}" press=".onCreatePhysInvDoc" type="Emphasized"/>
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                        <Column><Text text="{i18n>colMaterial}"/></Column>
                        <Column><Text text="{i18n>colPlant}"/></Column>
                        <Column><Text text="{i18n>colSalesOrder}"/></Column>
                        <Column><Text text="{i18n>colSalesOrderItem}"/></Column>
                        <Column><Text text="{i18n>colQuantity}"/></Column>
                        <Column><Text text="{i18n>colBaseUnit}"/></Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{Material}"/>
                            <Text text="{Plant}"/>
                            <Text text="{SalesOrder}"/>
                            <Text text="{SalesOrderItem}"/>
                            <Text text="{Quantity}"/>
                            <Text text="{BaseUnit}"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>
